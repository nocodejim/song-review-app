# Example Environment Variables for Docker Compose

# Database Credentials (for both MySQL service and PHP app)
MYSQL_DATABASE=song_reviews_db
MYSQL_USER=review_user
MYSQL_PASSWORD=your_strong_password # Change this!
MYSQL_ROOT_PASSWORD=your_strong_root_password # Change this!

# Optional: Set the host port mapping for the web service
# WEB_PORT=8080
